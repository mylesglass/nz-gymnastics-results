/** This was in .vscode in the home dir **/

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && uvicorn app.main:app --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      }
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      }
    },
    {
      "label": "DB Logs",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml logs -f db",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      }
    },
    {
      "label": "Dev Environment",
      "dependsOn": ["Backend", "Frontend", "DB Logs"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
